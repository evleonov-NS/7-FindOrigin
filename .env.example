# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Опционально: секрет для проверки webhook (заголовок X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# OpenRouter (рекомендуется) — модель openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Опционально для рейтинга OpenRouter
# OPENROUTER_SITE_URL=https://your-app.example
# OPENROUTER_APP_NAME=FindOrigin

# Альтернатива: прямой OpenAI (если нет OPENROUTER_API_KEY)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Serper — поиск источников (https://serper.dev, ~2500 бесплатных запросов)
SERPER_API_KEY=

# Публичный URL приложения (для кнопки Mini App в боте)
# Пример: https://7-find-origin.vercel.app
PUBLIC_APP_URL=

# Локально: разрешить /api/analyze без initData (только development)
# MINIAPP_DEV_BYPASS=1
