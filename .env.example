# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Опционально: секрет для проверки webhook (заголовок X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# OpenAI-совместимый API для извлечения фактов (опционально; без ключа работают правила)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Появится на этапе поиска источников
# SEARCH_API_KEY=
